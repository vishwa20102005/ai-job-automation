# CareerPilot AI Backend - Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=postgresql://careerpilot:careerpilot123@localhost:5432/careerpilot

# ==========================================
# SECURITY
# ==========================================
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-minimum-32-characters-here

# ==========================================
# CORS
# ==========================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ==========================================
# FILE UPLOAD
# ==========================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes

# ==========================================
# AI CONFIGURATION
# Default provider: "gemini" (recommended)
# ==========================================
AI_PROVIDER=gemini

# Google Gemini API (Recommended - models: gemini-3.8-flash, gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Azure OpenAI (Optional alternative)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ==========================================
# APP
# ==========================================
ENVIRONMENT=development
DEBUG=false
